# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Runtime settings
TELCLAW_SESSION_DIR=sessions
TELCLAW_DB_NAME=telclaw.db
TELCLAW_CHANNELS_FILE=channels.json
TELCLAW_ERROR_LOG=crawler_errors.log
TELCLAW_MAX_MEDIA_SIZE=2097152
TELCLAW_BASE_DELAY=8
TELCLAW_RANDOM_DELAY_MAX=400

# AI extraction via Groq
GROQ_API_KEY=your_groq_api_key
TELCLAW_GROQ_MODEL=qwen/qwen3.6-27b
TELCLAW_AI_EXTRACTION_ENABLED=false
TELCLAW_GROQ_REQUESTS_PER_MINUTE=30

# Advertio Ingest API — opt-in
# Obtain this key from the Advertio backend team. Never commit the real key.
TELCLAW_ADVERTIO_INGEST_ENABLED=false
# Dedicated external API hostname. Keep this configurable; Advertio may change it.
TELCLAW_ADVERTIO_BASE_URL=https://api.advertio.ir
TELCLAW_ADVERTIO_INGEST_KEY=your_advertio_ingest_key
# Must remain stable for all historical crawled listings.
TELCLAW_ADVERTIO_SOURCE_NAME=telegram-rent
# Start with false so listings enter PendingReview.
TELCLAW_ADVERTIO_AUTO_PUBLISH=false
# Service contract recommends 2–3 concurrent operations.
TELCLAW_ADVERTIO_CONCURRENCY=3
TELCLAW_ADVERTIO_TIMEOUT_SECONDS=60
