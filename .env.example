# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Optional runtime settings
TELCLAW_SESSION_DIR=sessions
TELCLAW_DB_NAME=telclaw.db
TELCLAW_CHANNELS_FILE=channels.json
TELCLAW_ERROR_LOG=crawler_errors.log
TELCLAW_MAX_MEDIA_SIZE=2097152
TELCLAW_BASE_DELAY=8
TELCLAW_RANDOM_DELAY_MAX=400

# AI extraction via Groq
# Get your API key from the Groq Console.
GROQ_API_KEY=your_groq_api_key
TELCLAW_GROQ_MODEL=openai/gpt-oss-20b
# Keep this false until the Groq key is configured and test messages are ready.
TELCLAW_AI_EXTRACTION_ENABLED=false
# Keep below your actual Groq plan limit; 30 is a conservative Free Tier setting.
TELCLAW_GROQ_REQUESTS_PER_MINUTE=30
