# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Runtime settings
TELCLAW_SESSION_DIR=sessions
TELCLAW_DB_NAME=telclaw.db
TELCLAW_CHANNELS_FILE=channels.json
TELCLAW_ERROR_LOG=crawler_errors.log
TELCLAW_MAX_MEDIA_SIZE=2097152
TELCLAW_BASE_DELAY=8
TELCLAW_RANDOM_DELAY_MAX=400
# Re-check every channel/group after this many minutes.
TELCLAW_CRAWL_INTERVAL_MINUTES=5
# Stagger the initial start of channels/groups in the selected category.
TELCLAW_CHANNEL_INTERVAL_MINUTES=1

# AI provider priority. Configured providers form the generic failover chain.
AI_PROVIDER_1=groq
AI_PROVIDER_2=
AI_PROVIDER_3=

# AI via Groq
GROQ_API_KEY=your_groq_api_key
TELCLAW_GROQ_MODEL=qwen/qwen3.6-27b

# Optional failover providers.
GROQ_API_KEY_2=your_second_groq_api_key
TELCLAW_GROQ_MODEL_2=qwen/qwen3.6-27b

# Classification is independent from extraction.
TELCLAW_AI_CLASSIFICATION_ENABLED=true
TELCLAW_AI_CLASSIFICATION_BATCH_SIZE=50
TELCLAW_AI_CLASSIFICATION_MAX_RETRIES=3

# Global extraction switch retained for backward compatibility.
# false disables every category. When true, category flags below are evaluated independently.
TELCLAW_AI_EXTRACTION_ENABLED=true
TELCLAW_AI_EXTRACTION_HOUSINGLIST_ENABLED=true
TELCLAW_AI_EXTRACTION_TRANSFERLIST_ENABLED=true
TELCLAW_AI_EXTRACTION_JOBLIST_ENABLED=true

# Example: disable transfer extraction without disabling classification.
# TELCLAW_AI_EXTRACTION_TRANSFERLIST_ENABLED=false

TELCLAW_GROQ_REQUESTS_PER_MINUTE=30
TELCLAW_GROQ_RATE_LIMIT_MAX_RETRIES=5
TELCLAW_GROQ_RATE_LIMIT_MIN_WAIT_SECONDS=30
TELCLAW_GROQ_RATE_LIMIT_MAX_WAIT_SECONDS=180
TELCLAW_GROQ_MAX_COMPLETION_TOKENS=1200
TELCLAW_GROQ_INVALID_JSON_MAX_RETRIES=1

# Cloudflare Workers AI (set AI_PROVIDER_1=cloudflare to use it)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Optional additional Cloudflare credentials, used after cloudflare-1.
# CLOUDFLARE_ACCOUNT_ID_2=your_second_cloudflare_account_id
# CLOUDFLARE_API_TOKEN_2=your_second_cloudflare_api_token
# CLOUDFLARE_MODEL_2=@cf/meta/llama-3.3-70b-instruct-fp8-fast
TELCLAW_CLOUDFLARE_REQUESTS_PER_MINUTE=30
TELCLAW_CLOUDFLARE_TIMEOUT_SECONDS=60

# Generic provider failover and cooldowns.
TELCLAW_AI_FAILOVER_BASE_COOLDOWN_SECONDS=30
TELCLAW_AI_FAILOVER_MAX_COOLDOWN_SECONDS=300
TELCLAW_AI_FAILOVER_PERMANENT_COOLDOWN_SECONDS=3600

# Advertio Ingest API — opt-in
# Obtain this key from the Advertio backend team. Never commit the real key.
TELCLAW_ADVERTIO_INGEST_ENABLED=false
TELCLAW_ADVERTIO_BASE_URL=https://api.advertio.ir
TELCLAW_ADVERTIO_INGEST_KEY=your_advertio_ingest_key
TELCLAW_ADVERTIO_SOURCE_NAME=telegram-rent
TELCLAW_ADVERTIO_AUTO_PUBLISH=false
TELCLAW_ADVERTIO_CONCURRENCY=3
TELCLAW_ADVERTIO_TIMEOUT_SECONDS=60
