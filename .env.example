# Telegram API credentials
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Runtime settings
TELCLAW_SESSION_DIR=sessions
TELCLAW_DB_NAME=telclaw.db
TELCLAW_CHANNELS_FILE=channels.json
TELCLAW_ERROR_LOG=crawler_errors.log
TELCLAW_MAX_MEDIA_SIZE=2097152
TELCLAW_BASE_DELAY=8
TELCLAW_RANDOM_DELAY_MAX=400
TELCLAW_CRAWL_INTERVAL_MINUTES=5
TELCLAW_CHANNEL_INTERVAL_MINUTES=1
TELCLAW_PROCESSING_INTERVAL_MINUTES=1
TELCLAW_AI_INTERVAL_MINUTES=1

# AI provider priority: provider 1 is tried first, then provider 2 on failover.
# Extraction-only: after a provider exhausts its malformed-JSON retries, try
# another configured, available provider for this message. A single provider
# cannot recover this way; neither classification nor HTTP-rate-limit logic
# is changed by this safety fallback.
# To recover already failed records, use Back Office > Operations >
# AI Extraction Queue > Retry Invalid AI Extraction > Run AI Extraction.
AI_PROVIDER_1=groq
AI_PROVIDER_2=cloudflare

# Generic AI resilience controls
AI_RETRY_COUNT=3
AI_TIMEOUT_SECONDS=60
AI_COOLDOWN_SECONDS=200
AI_RECOVERY_INTERVAL_SECONDS=60

# Groq credentials (priority within Groq)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
TELCLAW_GROQ_MODEL=qwen/qwen3.6-27b
TELCLAW_GROQ_MODEL_2=qwen/qwen3.6-27b
TELCLAW_GROQ_MODEL_3=qwen/qwen3.6-27b

# Cloudflare Workers AI credentials (multiple credential sets are supported)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=
# Optional additional Cloudflare credentials:
# CLOUDFLARE_ACCOUNT_ID_2=
# CLOUDFLARE_API_TOKEN_2=
# CLOUDFLARE_MODEL_2=
# CLOUDFLARE_ACCOUNT_ID_3=
# CLOUDFLARE_API_TOKEN_3=
# CLOUDFLARE_MODEL_3=
TELCLAW_CLOUDFLARE_REQUESTS_PER_MINUTE=30
TELCLAW_CLOUDFLARE_TIMEOUT_SECONDS=60
# HTTP 200 can contain invalid JSON or extraction structure; both share this retry cap.
TELCLAW_CLOUDFLARE_INVALID_JSON_MAX_RETRIES=1
# Leave zero unless you verified your Workers AI model supports this output cap.
TELCLAW_CLOUDFLARE_MAX_TOKENS=0

# Existing Groq tuning (backward compatible)
TELCLAW_GROQ_REQUESTS_PER_MINUTE=30
# Organization-level Groq TPM; default is 8000 with 10% safety headroom.
# Verify your organization's actual per-model limit in the Groq console.
# This limits all Groq keys and both AI stages in one Telclaw process.
# If the queue runs across multiple processes/hosts, configure a shared
# distributed limiter before relying on this for an organization-wide cap.
TELCLAW_GROQ_TOKENS_PER_MINUTE=8000
TELCLAW_GROQ_TPM_HEADROOM_PERCENT=10
TELCLAW_GROQ_FAILOVER_THRESHOLD_SECONDS=200
TELCLAW_GROQ_RATE_LIMIT_MAX_RETRIES=5
TELCLAW_GROQ_RATE_LIMIT_MIN_WAIT_SECONDS=30
TELCLAW_GROQ_RATE_LIMIT_MAX_WAIT_SECONDS=180
TELCLAW_GROQ_MAX_COMPLETION_TOKENS=1200
TELCLAW_GROQ_INVALID_JSON_MAX_RETRIES=1

# AI classification
TELCLAW_AI_CLASSIFICATION_ENABLED=true
TELCLAW_AI_CLASSIFICATION_BATCH_SIZE=50
TELCLAW_AI_CLASSIFICATION_MAX_RETRIES=3

# AI extraction
TELCLAW_AI_EXTRACTION_ENABLED=true
TELCLAW_AI_EXTRACTION_HOUSINGLIST_ENABLED=true
TELCLAW_AI_EXTRACTION_TRANSFERLIST_ENABLED=true
TELCLAW_AI_EXTRACTION_JOBLIST_ENABLED=true

# Monitoring
TELCLAW_TELEGRAM_MONITOR_ENABLED=true
TELCLAW_TELEGRAM_BOT_TOKEN=
TELCLAW_TELEGRAM_MONITOR_REPORT_INTERVAL_MINUTES=30

# Enable the admin web back office and routed publication together.
# Terminate HTTPS at a reverse proxy that forwards to 127.0.0.1:8787.
TELCLAW_BACKOFFICE_ENABLED=false
TELCLAW_BACKOFFICE_PUBLIC_URL=https://backoffice.example.com
# Optional HTTPS reverse proxy port shown in the Telegram link (0 = use URL as is).
TELCLAW_BACKOFFICE_PUBLIC_PORT=0
TELCLAW_BACKOFFICE_HOST=127.0.0.1
TELCLAW_BACKOFFICE_PORT=8787
# Set both for direct HTTPS on the bind address and port (e.g. https://SERVER_IP:8787).
# For direct HTTP by IP, set PUBLIC_URL=http://SERVER_IP:8787, HOST=0.0.0.0,
# PORT=8787, PUBLIC_PORT=0 and leave both TLS paths empty.
TELCLAW_BACKOFFICE_TLS_CERT=
TELCLAW_BACKOFFICE_TLS_KEY=

# Advertio
TELCLAW_ADVERTIO_INGEST_ENABLED=false
TELCLAW_ADVERTIO_BASE_URL=https://api.advertio.ir
TELCLAW_ADVERTIO_INGEST_KEY=
TELCLAW_ADVERTIO_SOURCE_NAME=telegram-rent
TELCLAW_ADVERTIO_AUTO_PUBLISH=false
TELCLAW_ADVERTIO_CONCURRENCY=3
TELCLAW_ADVERTIO_TIMEOUT_SECONDS=60

# Cargo goes to passenger-cargo, independently of Telegram and housing.
# Historical processed transferlist rows are backfilled automatically:
# future trips, plus recent undated ads (default: last 30 days).
TELCLAW_ADVERTIO_CARGO_ENABLED=true
TELCLAW_ADVERTIO_CARGO_AUTO_PUBLISH=true
TELCLAW_ADVERTIO_CARGO_BACKFILL_DAYS=30
TELCLAW_ADVERTIO_CARGO_BATCH_SIZE=50
TELCLAW_ADVERTIO_CARGO_DAILY_LIMIT=250

# Jobs: opt in explicitly; eligible AI-validated listings use the Advertio API. No automatic history scan.
TELCLAW_ADVERTIO_JOBS_ENABLED=false
TELCLAW_ADVERTIO_JOBS_AUTO_PUBLISH=true
TELCLAW_ADVERTIO_JOBS_BACKFILL_ENABLED=false
TELCLAW_ADVERTIO_JOBS_BACKFILL_DAYS=7
TELCLAW_ADVERTIO_JOBS_FRESHNESS_DAYS=7
TELCLAW_ADVERTIO_JOBS_BATCH_SIZE=25
TELCLAW_ADVERTIO_JOBS_DAILY_LIMIT=200
TELCLAW_ADVERTIO_JOBS_MAX_ATTEMPTS=8
TELCLAW_ADVERTIO_JOBS_CLAIM_TIMEOUT_SECONDS=1800
# Shared AdvertioClient HTTP budget, including public catalogs and media calls.
# Confirm current Advertio production policy before deployment.
TELCLAW_ADVERTIO_DAILY_REQUEST_LIMIT=1000

# Dedicated Telegram transfer advertisement publisher.
# Reuses TELCLAW_TELEGRAM_BOT_TOKEN and sends AI-processed transferlist ads to this channel.
TELCLAW_TRANSFER_TELEGRAM_PUBLISH_ENABLED=false
TELCLAW_TRANSFER_TELEGRAM_CHANNEL=@your_transfer_channel
TELCLAW_TRANSFER_TELEGRAM_INTERVAL_MINUTES=1
TELCLAW_TRANSFER_TELEGRAM_TIMEOUT_SECONDS=30
