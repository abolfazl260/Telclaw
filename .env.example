# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Runtime settings
TELCLAW_SESSION_DIR=sessions
TELCLAW_DB_NAME=telclaw.db
TELCLAW_CHANNELS_FILE=channels.json
TELCLAW_ERROR_LOG=crawler_errors.log
TELCLAW_MAX_MEDIA_SIZE=2097152
TELCLAW_BASE_DELAY=8
TELCLAW_RANDOM_DELAY_MAX=400
# Re-check every channel/group after this many minutes.
TELCLAW_CRAWL_INTERVAL_MINUTES=5
# Stagger the initial start of channels/groups in the selected category.
TELCLAW_CHANNEL_INTERVAL_MINUTES=1

# Optional Telegram system-monitor bot (independent from the crawler client/session).
TELCLAW_TELEGRAM_MONITOR_ENABLED=false
TELCLAW_TELEGRAM_BOT_TOKEN=your_bot_token
# Recipient chat/user ID. Keep this as the authoritative routing value.
TELCLAW_TELEGRAM_CHAT_ID=your_chat_id
# Optional username for display/documentation only; sending uses CHAT_ID.
TELCLAW_TELEGRAM_CHAT_USERNAME=@your_username
TELCLAW_TELEGRAM_REPORT_INTERVAL_MINUTES=5
TELCLAW_TELEGRAM_ERROR_HISTORY_SIZE=100

# AI extraction via Groq
GROQ_API_KEY=your_groq_api_key
TELCLAW_GROQ_MODEL=qwen/qwen3.6-27b
TELCLAW_AI_EXTRACTION_ENABLED=false
TELCLAW_GROQ_REQUESTS_PER_MINUTE=30
# HTTP 429 retry policy. The extractor also honors Groq Retry-After and
# x-ratelimit-reset-tokens headers when they are present.
TELCLAW_GROQ_RATE_LIMIT_MAX_RETRIES=5
TELCLAW_GROQ_RATE_LIMIT_MIN_WAIT_SECONDS=30
TELCLAW_GROQ_RATE_LIMIT_MAX_WAIT_SECONDS=180
TELCLAW_GROQ_MAX_COMPLETION_TOKENS=1200
TELCLAW_GROQ_INVALID_JSON_MAX_RETRIES=1

# Advertio Ingest API — opt-in
# Obtain this key from the Advertio backend team. Never commit the real key.
TELCLAW_ADVERTIO_INGEST_ENABLED=false
TELCLAW_ADVERTIO_BASE_URL=https://api.advertio.ir
TELCLAW_ADVERTIO_INGEST_KEY=your_advertio_ingest_key
TELCLAW_ADVERTIO_SOURCE_NAME=telegram-rent
TELCLAW_ADVERTIO_AUTO_PUBLISH=false
TELCLAW_ADVERTIO_CONCURRENCY=3
TELCLAW_ADVERTIO_TIMEOUT_SECONDS=60